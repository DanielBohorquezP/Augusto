# ── Newsletter → Google Sheets ────────────────────────────────────────────────
# URL del Google Apps Script desplegado como Web App.
# Pasos completos de configuración: docs/INTEGRACIONES.md
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXX/exec

# ── Formulario de contacto → Email (Web3Forms) ───────────────────────────────
# Access key: https://web3forms.com (gratis, sin verificar dominio)
# Debe ser NEXT_PUBLIC_ porque el envío ocurre desde el navegador: el plan gratuito
# de Web3Forms bloquea las peticiones hechas server-to-server. Web3Forms confirma
# que esta clave es segura para exponer públicamente.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Formulario de contacto → Google Sheets ───────────────────────────────────
# URL del Google Apps Script desplegado como Web App (hoja aparte de la del
# newsletter). Opcional: si no está, el contacto sigue funcionando solo por email.
# Pasos completos de configuración: docs/INTEGRACIONES.md
GOOGLE_SHEETS_CONTACT_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXX/exec

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# ID de medición de tu propiedad GA4 (Admin → Flujos de datos → tu sitio web).
# Pasos completos: docs/INTEGRACIONES.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Search Console (verificación por meta tag) ────────────────────────
# Search Console → Configuración → Verificación de la propiedad → etiqueta HTML.
# Copia solo el valor del atributo content="..." (no la etiqueta completa).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
